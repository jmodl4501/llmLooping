# ============================================================
# llm-loop 설정 — 이 파일을 복사해 config.env 로 저장한 뒤 편집
# (setup.bat이 자동으로 복사합니다)
# ============================================================

# ---- 기본 연결 (Arena.ai 프리셋) ----
LLM_ORIGIN=https://arena.ai
LLM_START_URL=https://arena.ai/agent
CDP_PORT=9222

# Chrome 실행 파일 경로 (비워두면 자동 탐지)
CHROME_BIN=

# ---- UI 선택자 ----
# 비워두면 내장 후보(#prompt-textarea, [contenteditable], textarea 등)를 자동 시도.
# 사이트 개편으로 자동 탐지가 실패하면 브라우저 DevTools(F12)로 확인해 지정.
EDITOR_CSS=
REPLY_CSS=
SEND_CSS=

# ---- 에이전트 동작 (agent.py) ----
AGENT_WORKSPACE=workspace
AGENT_MAX_STEPS=30
# Arena Agent Mode는 수 분 이상 걸릴 수 있어 응답 대기를 넉넉히 잡는다(초)
RESPONSE_TIMEOUT=1800
# 명령 하나의 실행 제한(초)
EXEC_TIMEOUT=120
# 승인 정책: auto(완전 자동) / smart(위험 명령만 확인) / ask(매번 확인)
APPROVAL=auto
# 1이면 에이전트 종료 시 자기가 띄운 Chrome도 종료 (기본: 유지)
AGENT_CLOSE_BROWSER=

# ---- ZIP 검증 루프 (controller.py) ----
RUNNER=docker
MAX_ROUNDS=4
JOB_IMAGE=python:3.12-slim
ZIP_ROLE=link
